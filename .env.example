# Meter Reading Inference Service Configuration

# Path to pipeline YAML configuration file
PIPELINE_CONFIG_PATH=config/pipeline.demo.example.yaml

# Path to Core meter-reading-engine-v2 repository (for git revision verification)
CORE_REPO_PATH=D:\Projects\meter-reading-engine-v2

# Optional overrides for models and artifact storage
OCR_MODEL_PATH=
YOLO_MODEL_PATH=D:\Models\meter-reading-engine\lcd-reading-value-yolo-v1\best.pt
ARTIFACT_ROOT=local_artifacts

# Service limits and concurrency
MAX_UPLOAD_BYTES=10485760
MAX_INFERENCE_CONCURRENCY=1
ENABLE_LEARNED_PRIMARY=false

# CORS Allowed Origins (JSON array or comma-separated)
ALLOWED_ORIGINS=["http://localhost:3000"]

# Explicit default localization profiles mapping (JSON format)
DEFAULT_LOCALIZATION_PROFILES={"VSEE_VSE3T": "vsee_vse3t_station_a_v1", "GELEX_ME40": "gelex_me40_station_b_v1"}

# Logging
LOG_LEVEL=INFO
